# Cache rules for files served by the Workers assets binding (mirrors headers() in next.config.js).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/pdf.worker.js
  Cache-Control: public, max-age=31536000, immutable
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/favicon.ico
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/logo.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/og-image.png
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/file.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/globe.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/next.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/vercel.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/window.svg
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
